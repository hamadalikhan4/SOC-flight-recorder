  "components": {
    "schemas": {
      "Batch": {
        "properties": {
          "schema_version": {
            "type": "integer",
            "const": 1,
            "title": "Schema Version",
            "default": 1
          },
          "events": {
            "items": {
              "$ref": "#/components/schemas/Event"
            },
            "type": "array",
            "maxItems": 200,
            "minItems": 1,
            "title": "Events"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "events"
        ],
        "title": "Batch"
      },
      "Disposition": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "open",
              "resolved"
            ],
            "title": "Status"
          },
          "note": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Note"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status",
          "note"
        ],
        "title": "Disposition"
      },
      "Enroll": {
        "properties": {
          "hostname": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Hostname"
          },
          "platform": {
            "type": "string",
            "enum": [
              "windows",
              "replay"
            ],
            "title": "Platform",
            "default": "windows"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "hostname"
        ],
        "title": "Enroll"
      },
      "Event": {
        "properties": {
          "event_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 16,
            "pattern": "^[a-zA-Z0-9_-]+$",
            "title": "Event Id"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "title": "Timestamp"
          },
          "category": {
            "type": "string",
            "enum": [
              "process",
              "network",
              "dns",
              "file",
              "health"
            ],
            "title": "Category"
          },
          "process_guid": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 128
              },
              {
                "type": "null"
              }
            ],
            "title": "Process Guid"
          },
          "parent_guid": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 128
              },
              {
                "type": "null"
              }
            ],
            "title": "Parent Guid"
          },
          "process_id": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Process Id"
          },
          "image": {
            "type": "string",
            "maxLength": 2048,
            "title": "Image",
            "default": ""
          },
          "parent_image": {
            "type": "string",
            "maxLength": 2048,
            "title": "Parent Image",
            "default": ""
          },
          "command_line": {
            "type": "string",
            "maxLength": 16384,
            "title": "Command Line",
            "default": ""
          },
          "user": {
            "type": "string",
            "maxLength": 512,
            "title": "User",
            "default": ""
          },
          "target": {
            "type": "string",
            "maxLength": 4096,
            "title": "Target",
            "default": ""
          },
          "source_record_id": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Source Record Id"
          },
          "source_epoch": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Source Epoch"
          },
          "provider": {
            "type": "string",
            "maxLength": 128,
            "title": "Provider",
            "default": "Microsoft-Windows-Sysmon"
          },
          "synthetic": {
            "type": "boolean",
            "title": "Synthetic",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "event_id",
          "timestamp",
          "category",
          "source_record_id",
          "source_epoch"
        ],
        "title": "Event"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Heartbeat": {
        "properties": {
          "queued_events": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Queued Events"
          },
          "buffer_events": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Buffer Events"
          },
          "last_record_id": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Last Record Id"
          },
          "collector_status": {
            "type": "string",
            "enum": [
              "running",
              "replay",
              "error"
            ],
            "title": "Collector Status"
          },
          "message": {
            "type": "string",
            "maxLength": 1024,
            "title": "Message",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "queued_events",
          "buffer_events",
          "last_record_id",
          "collector_status"
        ],
        "title": "Heartbeat"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}